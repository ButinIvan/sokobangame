@page "/"
@using Sokoban.Blazor.Game
@using Microsoft.JSInterop
@inject LevelService LevelService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Sokoban Ivan</PageTitle>

<main class="game-shell">
    <header class="topbar">
        <div class="brand">
            <span class="brand-mark" aria-hidden="true">SI</span>
            <div><h1>Sokoban Ivan</h1><p>C# + JavaScript</p></div>
        </div>
        <div class="stats" aria-label="Статистика игры">
            <div class="stat"><span>Уровень</span><strong id="level-value">@LevelLabel</strong></div>
            <div class="stat"><span>Ходы</span><strong id="moves-value">0</strong></div>
            <div class="stat"><span>Ящики</span><strong id="boxes-value">@PlacedBoxes / @CurrentState.Boxes.Count</strong></div>
        </div>
        <div class="actions">
            <button id="undo-button" class="icon-button" type="button" title="Отменить ход" disabled>&#8630;</button>
            <button id="restart-button" class="icon-button" type="button" title="Начать заново">&#8635;</button>
            <button id="sound-button" class="icon-button" type="button" title="Выключить звук">&#9835;</button>
        </div>
    </header>

    <section class="play-area">
        <aside class="level-panel" aria-label="Выбор уровня">
            <p class="panel-label">СЕКТОРЫ</p>
            <nav class="level-list">
                @foreach (var level in Levels)
                {
                    <button type="button" data-level="@level.Id" class="level-button @(CurrentLevelId == level.Id ? "active" : null)" @onclick="() => SelectLevel(level.Id)">
                        <span class="level-number">@level.Id.ToString("00")</span>
                        <span class="level-name">@level.Name</span>
                    </button>
                }
            </nav>
            <button id="random-level-button" class="random-level-button @(CurrentState.IsRandom ? "active" : null)" type="button" @onclick="SelectRandomLevel">
                <span aria-hidden="true">&#9851;</span> Случайный сектор
            </button>
            <div class="legend">
                <p><i class="legend-goal"></i>Место для ящика</p>
                <p><i class="legend-box"></i>Груз</p>
            </div>
        </aside>

        <div class="board-stage">
            <div id="board" class="board" role="grid" aria-label="Игровое поле Sokoban"></div>
            <p id="game-hint" class="hint">@(CurrentState.IsRandom ? "Случайная решаемая расстановка" : "Доставьте все ящики на отмеченные места")</p>
        </div>

        <aside class="control-panel">
            <p class="panel-label">УПРАВЛЕНИЕ</p>
            <div class="key-guide" aria-hidden="true">
                <span></span><kbd>&uarr;</kbd><span></span>
                <kbd>&larr;</kbd><kbd>&darr;</kbd><kbd>&rarr;</kbd>
            </div>
            <p>Стрелки или WASD</p>
            <div class="mobile-controls" aria-label="Экранное управление">
                <span></span><button type="button" data-direction="up" aria-label="Вверх">&uarr;</button><span></span>
                <button type="button" data-direction="left" aria-label="Влево">&larr;</button>
                <button type="button" data-direction="down" aria-label="Вниз">&darr;</button>
                <button type="button" data-direction="right" aria-label="Вправо">&rarr;</button>
            </div>
            <div class="shortcut"><kbd>Z</kbd><span>Отменить ход</span></div>
            <div class="shortcut"><kbd>R</kbd><span>Начать заново</span></div>
        </aside>
    </section>
</main>

<dialog id="win-dialog" class="win-dialog">
    <div class="win-icon" aria-hidden="true">&#10003;</div>
    <p class="eyebrow">СЕКТОР ОЧИЩЕН</p>
    <h2>Отличная работа!</h2>
    <p id="win-summary">Все ящики на местах.</p>
    <button id="next-button" class="primary-button" type="button">Следующий уровень <span>&rarr;</span></button>
    <button id="replay-button" class="text-button" type="button">Пройти ещё раз</button>
</dialog>

@code {
    private IReadOnlyList<LevelDefinition> Levels { get; } = LevelCatalog.Levels;
    private LevelState CurrentState { get; set; } = null!;
    private int? CurrentLevelId { get; set; } = 1;
    private IJSObjectReference? _gameModule;
    private DotNetObjectReference<Home>? _componentReference;
    private bool _pendingLoad;
    private string LevelLabel => CurrentState.IsRandom ? "Случайный" : $"{CurrentLevelId} / {Levels.Count}";
    private int PlacedBoxes => CurrentState.Boxes.Count(CurrentState.Goals.Contains);

    protected override void OnInitialized() => CurrentState = LevelService.GetLevel(1);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _gameModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sokoban.js");
            _componentReference = DotNetObjectReference.Create(this);
            await _gameModule.InvokeVoidAsync("initialize", CurrentState, CurrentLevelId, _componentReference);
        }
        else if (_pendingLoad && _gameModule is not null)
        {
            _pendingLoad = false;
            await _gameModule.InvokeVoidAsync("loadLevel", CurrentState, CurrentLevelId);
        }
    }

    private void SelectLevel(int id)
    {
        CurrentLevelId = id;
        CurrentState = LevelService.GetLevel(id);
        _pendingLoad = true;
    }

    private void SelectRandomLevel()
    {
        CurrentLevelId = null;
        CurrentState = LevelService.CreateRandomLevel();
        _pendingLoad = true;
    }

    [JSInvokable]
    public LevelState GetLevelForJavaScript(int id) => LevelService.GetLevel(id);

    [JSInvokable]
    public LevelState GetRandomLevelForJavaScript() => LevelService.CreateRandomLevel();

    public async ValueTask DisposeAsync()
    {
        if (_gameModule is not null)
        {
            try
            {
                await _gameModule.InvokeVoidAsync("dispose");
                await _gameModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _componentReference?.Dispose();
    }
}
